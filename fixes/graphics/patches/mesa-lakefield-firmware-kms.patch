+/* Local opt-in experiment: render on i915, export through the firmware KMS
+ * device. Existing generic PRIME export code handles the distinct DRM fd.
+ * No native panel programming, scanout test or conformance is implied.
+ */
+struct pipe_screen *
+iris_screen_create_lkf_firmware_kms(int gpu_fd, int kms_fd,
+                                  const struct pipe_screen_config *config)
+{
+   int output_fd = os_dupfd_cloexec(kms_fd);
+   if (output_fd < 0)
+      return NULL;
+   struct pipe_screen *base = iris_screen_create(gpu_fd, config);
+   if (!base) {
+      close(output_fd);
+      return NULL;
+   }
+   struct iris_screen *screen = (struct iris_screen *)base;
+   if (screen->devinfo->platform != INTEL_PLATFORM_LKF) {
+      base->destroy(base);
+      close(output_fd);
+      return NULL;
+   }
+   close(screen->winsys_fd);
+   screen->winsys_fd = output_fd;
+   screen->lkf_firmware_kms = true;
+   return base;
+}
