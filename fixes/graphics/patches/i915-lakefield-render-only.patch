+/* A render-only LKF test must not erase firmware scanout translations
+ * during full-address-space suspend/resume cleanup either.
+ */
+static void lkf_safe_clear_all(struct i915_address_space *vm)
+{
+	struct i915_ggtt *ggtt;
+	struct drm_mm_node *fb;
+	u64 end;
+
+	if (!vm->is_ggtt || INTEL_INFO(vm->i915)->platform != INTEL_LAKEFIELD) {
+		vm->clear_range(vm, 0, vm->total);
+		return;
+	}
+	ggtt = i915_vm_to_ggtt(vm);
+	fb = &ggtt->lkf_boot_fb;
+	if (!drm_mm_node_allocated(fb)) {
+		vm->clear_range(vm, 0, vm->total);
+		return;
+	}
+	end = fb->start + fb->size;
+	if (fb->start)
+		vm->clear_range(vm, 0, fb->start);
+	if (end < vm->total)
+		vm->clear_range(vm, end, vm->total - end);
+}
