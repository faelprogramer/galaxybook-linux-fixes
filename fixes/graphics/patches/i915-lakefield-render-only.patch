+/* Preserve the exact firmware framebuffer range, not an arbitrary GPU ID
+ * alias. Only applies to the opt-in Samsung LKF render-only descriptor.
+ * The child platform resource must lie fully inside this GPU's aperture.
+ */
+static int lkf_reserve_boot_fb(struct i915_ggtt *ggtt)
+{
+	struct drm_i915_private *i915 = ggtt->vm.i915;
+	struct device *child;
+	struct resource *res;
+	u64 start, end;
+	int ret;
+
+	if (INTEL_INFO(i915)->platform != INTEL_LAKEFIELD)
+		return 0;
+
+	child = device_find_child_by_name(i915->drm.dev, "simple-framebuffer.0");
+	if (!child)
+		return -ENODEV;
+	res = platform_get_resource(to_platform_device(child), IORESOURCE_MEM, 0);
+	if (!res || res->end < res->start ||
+	    res->start < ggtt->gmadr.start || res->end > ggtt->gmadr.end) {
+		put_device(child);
+		return -EINVAL;
+	}
+	start = round_down(res->start - ggtt->gmadr.start, (u64)PAGE_SIZE);
+	end = round_up(res->end - ggtt->gmadr.start + 1, (u64)PAGE_SIZE);
+	put_device(child);
+	if (end <= start || end >= ggtt->mappable_end || end >= ggtt->vm.total - PAGE_SIZE)
+		return -EINVAL;
+
+	ggtt->lkf_boot_fb.start = start;
+	ggtt->lkf_boot_fb.size = end - start;
+	ggtt->lkf_boot_fb.color = I915_COLOR_UNEVICTABLE;
+	ret = drm_mm_reserve_node(&ggtt->vm.mm, &ggtt->lkf_boot_fb);
+	if (!ret)
+		drm_info(&i915->drm, "LKF experiment: preserving firmware framebuffer GGTT [%llx, %llx)\n", start, end);
+	return ret;
+}
+
+static void lkf_release_boot_fb(struct i915_ggtt *ggtt)
+{
+	if (drm_mm_node_allocated(&ggtt->lkf_boot_fb))
+		drm_mm_remove_node(&ggtt->lkf_boot_fb);
+}
