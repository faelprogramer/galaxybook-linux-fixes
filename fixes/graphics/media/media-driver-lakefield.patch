+    MEDIA_WR_SKU(skuTable, FtrEncodeMPEG2, 0);
+    MEDIA_WR_SKU(skuTable, FtrEncodeVP8, 0);
+    MEDIA_WR_SKU(skuTable, FtrEncodeVP9Vdenc, 0);
+    MEDIA_WR_SKU(skuTable, FtrEncodeVP9Vdenc10bit420, 0);
+    MEDIA_WR_SKU(skuTable, FtrEncodeVP9Vdenc10bit444, 0);
+    MEDIA_WR_SKU(skuTable, FtrEncodeVP9Vdenc8bit444, 0);
+    MEDIA_WR_SKU(skuTable, FtrHDR, 0);
+    MEDIA_WR_SKU(skuTable, FtrMemoryCompression, 0);
+    MEDIA_WR_SKU(skuTable, FtrSFCPipe, 0);
+    MEDIA_WR_SKU(skuTable, FtrVERing, 0);
+    MEDIA_WR_SKU(skuTable, FtrVp10BitSupport, 0);
+    MEDIA_WR_SKU(skuTable, FtrVpP010Output, 0);
+    return true;
